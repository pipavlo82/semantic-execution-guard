{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pipavlo82/semantic-execution-guard/relations/robinhood-stock-token-v0/relation.schema.json",
  "title": "Synthetic Robinhood Stock Token relation input v0",
  "description": "Local normalized fixture contract, not the Robinhood wire schema. Live inputs require a separately reviewed evidence adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_profile_id",
    "fixture_kind",
    "case_id",
    "requested_claim_type",
    "quote",
    "multiplier",
    "context",
    "conversion"
  ],
  "properties": {
    "relation_profile_id": {
      "const": "semantic-execution-guard.robinhood-stock-token.v0"
    },
    "fixture_kind": {
      "const": "SYNTHETIC_RELATION_FIXTURE"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "requested_claim_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "quote": {
      "$ref": "#/$defs/quote"
    },
    "multiplier": {
      "anyOf": [
        {
          "$ref": "#/$defs/multiplier"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "conversion": {
      "anyOf": [
        {
          "$ref": "#/$defs/conversion"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "chain_id",
        "contract_address"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "chain_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "asset",
        "source_surface",
        "authority_class",
        "currency",
        "price_side",
        "mantissa",
        "decimals",
        "already_adjusted",
        "observed_at",
        "state_id"
      ],
      "properties": {
        "claim_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "source_surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "authority_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "price_side": {
          "enum": [
            "BID",
            "ASK"
          ],
          "type": "string"
        },
        "mantissa": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "already_adjusted": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "multiplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "asset",
        "source_surface",
        "authority_class",
        "unit",
        "mantissa",
        "decimals",
        "observed_at",
        "state_id",
        "effective_from",
        "effective_until"
      ],
      "properties": {
        "claim_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "source_surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "authority_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "unit": {
          "const": "SHARES_PER_TOKEN"
        },
        "mantissa": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effective_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effective_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "currency",
        "price_side",
        "quote_time",
        "effective_state",
        "state_observed_at",
        "effective_from",
        "effective_until",
        "raw_decimals",
        "multiplier_decimals",
        "output_decimals"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "price_side": {
          "enum": [
            "BID",
            "ASK"
          ],
          "type": "string"
        },
        "quote_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effective_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state_observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effective_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effective_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "multiplier_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "output_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "quote_digest",
        "multiplier_digest",
        "raw_decimals",
        "multiplier_decimals",
        "output_decimals"
      ],
      "properties": {
        "operation": {
          "enum": [
            "MULTIPLY_EXACT",
            "DIRECT_PROMOTION"
          ],
          "type": "string"
        },
        "quote_digest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "multiplier_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "multiplier_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "output_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    }
  }
}
